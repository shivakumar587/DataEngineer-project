		{
			"name": "[concat(parameters('factoryName'), '/pl_gold_runner')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Generic Gold runner — called by pl_gold_dynamic_foreach once per notebook.\n\nReceives parameters from the parent ForEach:\n  p_notebook   : notebook name only (e.g. 'nb_gold_dim_station')\n  p_run_date   : YYYY-MM-DD or '' for full load\n  p_run_type   : 'incremental' | 'full'\n\nBuilds the full Databricks workspace path at runtime:\n  /Users/hariomsuryawanshi68258@gmail.com/<p_notebook>\n\nThis single pipeline replaces individual pl_gold_<entity> pipelines.\nAdding a new Gold notebook = INSERT one row in ev_catalog.gold.gold_control.",
				"activities": [
					{
						"name": "act_run_gold_notebook",
						"description": "Execute the Gold notebook whose name comes from the control table row.",
						"type": "DatabricksNotebook",
						"dependsOn": [],
						"policy": {
							"timeout": "0.02:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": {
								"value": "@concat('/Users/shiva87.palavarapu@gmail.com/', pipeline().parameters.p_notebook)",
								"type": "Expression"
							},
							"baseParameters": {
								"p_run_date": {
									"value": "@if(empty(pipeline().parameters.p_run_date), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), pipeline().parameters.p_run_date)",
									"type": "Expression"
								},
								"p_run_type": {
									"value": "@pipeline().parameters.p_run_type",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "ls_databricl",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_notebook": {
						"type": "string",
						"defaultValue": "nb_gold_dim_station"
					},
					"p_run_date": {
						"type": "string"
					},
					"p_run_type": {
						"type": "string",
						"defaultValue": "incremental"
					}
				},
				"folder": {
					"name": "gold"
				},
				"annotations": [],
				"lastPublishTime": "2026-11-09T07:36:09Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_databricl')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_silver_payments')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Triggers the Silver transformation notebook for sl_payments.\n\np_run_date (optional override):\n  - Leave blank when running via trigger  -> notebook receives today's date from TriggerTime\n  - Pass YYYY-MM-DD for manual backfill  -> notebook reads that specific Bronze partition\n\nNotebook: /Users/hariomsuryawanshi68258@gmail.com/nb_silver_payments\nSink    : ev_catalog.silver.sl_payments (Delta MERGE on payment_id)",
				"activities": [
					{
						"name": "act_silver_payments",
						"description": "Runs nb_silver_payments.\np_run_date logic:\n  - If pipeline parameter p_run_date is provided -> use it (backfill)\n  - Otherwise                                    -> use formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd') (daily run)",
						"type": "DatabricksNotebook",
						"dependsOn": [],
						"policy": {
							"timeout": "0.02:00:00",
							"retry": 1,
							"retryIntervalInSeconds": 60,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": {
								"value": "@concat('/Users/shiva87.palavarapu@gmail.com/', pipeline().parameters.p_notebook)",
								"type": "Expression"
							},
							"baseParameters": {
								"p_run_date": {
									"value": "@pipeline().parameters.p_run_date",
									"type": "Expression"
								},
								"p_run_type": {
									"value": "@pipeline().parameters.p_run_type",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "ls_databricl",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_run_date": {
						"type": "String"
					},
					"p_run_type": {
						"type": "string",
						"defaultValue": "incremental"
					},
					"p_notebook": {
						"type": "string",
						"defaultValue": "nb_silver_charge_cards"
					}
				},
				"folder": {
					"name": "silver"
				},
				"annotations": [],
				"lastPublishTime": "2026-11-06T06:54:39Z"
			},
			"dependsOn": [
